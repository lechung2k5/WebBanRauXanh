# =============================================================================
# HONA FRESH - PRODUCTION ENV TEMPLATE (Copy thành .env.prod trên EC2)
# =============================================================================

# 1. PostgreSQL (pgvector:pg16)
POSTGRES_DB=webbanrau_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# 2. Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# 3. Backend Port & JVM RAM (t2.micro 1GB RAM: -Xmx450m -Xms200m | t3.small/medium 2GB+: -Xmx768m -Xms256m)
BACKEND_PORT=8080
JAVA_TOOL_OPTIONS=-Xmx512m -Xms256m
FLYWAY_ENABLED=true
SWAGGER_ENABLED=false

# 4. Security & CORS (Bắt buộc thay JWT_SECRET >= 32 ký tự ngẫu nhiên)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_PRODUCTION_SECRET_KEY_2026
JWT_ACCESS_SECONDS=900
# Liệt kê tất cả domain Frontend (Vercel, domain riêng, IP EC2...) cách nhau dấu phẩy
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,capacitor://localhost
GOOGLE_CLIENT_ID=

# 5. Gemini AI
GEMINI_API_KEY=

# 6. Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# 7. Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 8. SePay Webhook
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=

# 9. Warehouse IoT (ESP32 Wokwi)
IOT_INGEST_KEY=CHANGE_ME_IOT_INGEST_KEY
